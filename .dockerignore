# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Test files and cache
tests/
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover
.hypothesis/

# Build artifacts
dist/
build/
*.egg-info/
*.egg
.eggs/

# Development files
.git/
# Never ship a developer's locally-generated version stub: the runtime stage
# copies the source tree into /app, so it would override the wheel's real
# version at import time.
media_preview_generator/_version.py
.github/
.gitignore
.vscode/
.idea/
*.md
!README.md
!docker/ffmpeg-loudness/README.md

# Environment files
.env
.env.*
*.local

# Virtual environments
venv/
.venv/
ENV/
env/

# IDE and editor files
*.swp
*.swo
*~
.DS_Store

# Documentation
docs/
*.rst

# Unraid templates (not needed in image)
unraid-templates/

# Sources the app image never COPYs (it uses only scripts/fetch_textdet_model.py from here).
# plex-marker-agent/ stays in: its image builds from the repo root context.
emby-plugin/
jellyfin-plugin/
tools/
scripts/*
!scripts/fetch_textdet_model.py
