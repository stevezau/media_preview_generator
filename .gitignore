docs/design/intro-credits/evidence/**/*.json
docs/design/intro-credits/evidence/**/*.jsonl
# Phase-4 anime id maps: third-party data, multi-MB, and neither upstream repo carries a licence
docs/design/intro-credits/evidence/online/phase4/animelists.xml
docs/design/intro-credits/evidence/lab/*_truth.txt
docs/design/intro-credits/evidence/lab/prod_plex_baseline.txt
docs/design/intro-credits/evidence/credits/spot.txt
docs/design/intro-credits/evidence/credits/framechecks/

