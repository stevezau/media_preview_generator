tmp_migration_test/

# Local planning files
plan.md

# Superpowers skill artifacts (plans, audits, brainstorms) — local-only working notes
docs/superpowers/

# Claude Code local overrides (not for source control)
CLAUDE.local.md
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Playwright MCP session artifacts (snapshots, console logs)
.playwright-mcp/

# setuptools-scm auto-generated version file
plex_generate_previews/_version.py
# setuptools-scm writes this at build time. The entry above still names the
# PRE-RENAME package, so after the rename the real one was committed and
# froze at 3.7.6.dev142 — then shadowed every image whose wheel metadata was
# the 0.0.0 fallback, making :dev report a version from four releases ago.
media_preview_generator/_version.py

# CI-generated release-notes bundle. Source of truth is GitHub Releases;
# CI fetches and bakes into the docker image at build time. Local
# checkouts can run `python3 scripts/refresh_release_notes.py` to
# populate it for offline dev, but the file is never committed.
media_preview_generator/release_notes.json
# Ad-hoc screenshots from Playwright UI verification — keep local only.
# Real docs screenshots should live under docs/ and be added explicitly.
*.png
!docs/**/*.png

# Intro & Credits evidence: local-only files (tokens, large dumps, regenerable media, Emby's proprietary DLLs)
docs/design/intro-credits/evidence/lab/env
docs/design/intro-credits/evidence/lab/synth/
docs/design/intro-credits/evidence/lab/results/
docs/design/intro-credits/evidence/lab/scale_mounts.sh
