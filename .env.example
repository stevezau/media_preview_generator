# Media Preview Generator - infrastructure environment variables.
#
# Copy to .env and uncomment what you need. Everything else (Plex/Emby/Jellyfin servers, GPUs, workers,
# schedules) is configured in the web UI and stored in settings.json under CONFIG_DIR.
# See docs/reference.md#infrastructure-variables for details.

# Directory for settings.json, auth, schedules and backups
# CONFIG_DIR=/config

# Web server port
# WEB_PORT=8080

# User / group the container runs as (Unraid: 99 / 100)
# PUID=1000
# PGID=1000

# Timezone, e.g. America/New_York
# TZ=UTC

# Authentication: "external" disables built-in auth (reverse proxy / VPN in front)
# AUTH_METHOD=internal

# Fixed web UI token (overrides the one set in the setup wizard). Leave unset to auto-generate.
# WEB_AUTH_TOKEN=

# Fixed Flask session signing key. Leave unset to auto-generate and persist in CONFIG_DIR.
# FLASK_SECRET_KEY=

# Mark session cookies secure. Set to true when served over HTTPS.
# HTTPS=false

# Allowed CORS origins (comma-separated)
# CORS_ORIGINS=*

# Log format: "pretty" or "json" (one JSON object per line)
# LOG_FORMAT=pretty

# Restrict where Plex config folders / media paths can be validated (default: whole filesystem)
# PLEX_DATA_ROOT=/
# MEDIA_ROOT=/

# Rate-limit counter backend (the in-memory default suits a single container)
# RATELIMIT_STORAGE_URL=memory://

# Settings-file backups: snapshots kept per file, and max age in days (0 = no age limit).
# Only used until you set them in Settings > Backups.
# CONFIG_BACKUP_KEEP=10
# CONFIG_BACKUP_MAX_AGE_DAYS=0

# Development only: start gunicorn with live reload
# DEV_RELOAD=false
